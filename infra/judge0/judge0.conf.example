# Copy to judge0.conf and fill in secrets (openssl rand -hex 32). judge0.conf is git-ignored.
AUTHN_HEADER=X-Auth-Token
AUTHN_TOKEN=change-me-to-a-long-random-token
ENABLE_NETWORK=false
ALLOW_ENABLE_NETWORK=false
ENABLE_COMPILER_OPTIONS=true
CPU_TIME_LIMIT=2
MAX_CPU_TIME_LIMIT=4
WALL_TIME_LIMIT=5
MAX_WALL_TIME_LIMIT=5
MEMORY_LIMIT=131072
MAX_MEMORY_LIMIT=524288
MAX_FILE_SIZE=64
MAX_PROCESSES_AND_OR_THREADS=64
ENABLE_WAIT_RESULT=true
REDIS_HOST=redis
REDIS_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_DB=judge0
POSTGRES_USER=judge0
POSTGRES_PASSWORD=change-me
