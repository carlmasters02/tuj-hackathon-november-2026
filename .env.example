# Copy to apps/web/.env.local (never commit it). Generate the HM_* values with: pnpm gen:keys

# Supabase project (Project Settings → API). The anon/publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_, never import from client code.
SUPABASE_SERVICE_ROLE_KEY=

# App secrets — 32 random bytes each, base64 (pnpm gen:keys)
# HM_MASTER_KEY: AES-256-GCM key for originals, drafts, saved solutions
# HM_SIGNING_KEY: Ed25519 seed that signs certificates
# HM_MEDIA_HMAC_KEY: signs 5-minute media URLs
# HM_EXT_TOKEN_PEPPER: pepper for extension-token hashes
# HM_WATERMARK_KEY: HMAC key inside the invisible image watermark
HM_MASTER_KEY=
HM_SIGNING_KEY=
HM_MEDIA_HMAC_KEY=
HM_EXT_TOKEN_PEPPER=
HM_WATERMARK_KEY=

# Code runner (private network only)
CODE_RUNNER=piston
PISTON_URL=http://127.0.0.1:2000
JUDGE0_URL=http://127.0.0.1:2358
JUDGE0_AUTH_TOKEN=

# Optional: public origin used for the CSRF Origin check behind a proxy
# NEXT_PUBLIC_SITE_URL=https://humagination.example

# DEMO MODE (testing only): skip login and sign everyone in to one shared demo account.
# Never enable where real users sign up. Optional HM_DEMO_EMAIL picks the demo account's address.
HM_DEMO_MODE=false
# HM_DEMO_EMAIL=demo@humagination.app

# Show "Continue with Google" once the Google provider is configured in Supabase
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
